{
    "manifest_version": 3,
    "name": "Lumen",
    "version": "0.3.0.5",
    "description": "Manix's nightly version.",
    "action": {
        "default_title": "Lumen",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "js/background.js"
    },
    "permissions": [
        "storage"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
