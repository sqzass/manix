{
    "manifest_version": 3,
    "name": "Manix",
    "version": "0.3.0.5",
    "description": "Browser hotswap — user agent, geolocation, and more. Click and disappear.",
    "action": {
        "default_title": "Manix",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "js/background.js"
    },
    "permissions": [
        "storage",
        "scripting",
        "tabs",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset-1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
